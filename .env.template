# Copy this file to `.env` (git-ignored) and fill in your real credentials.
# Never commit `.env` — it holds your Garmin Connect password.

# --- Garmin Connect credentials (required) ---
GARMIN__EMAIL=you@example.com
GARMIN__PASSWORD=your-garmin-password

# --- Garmin Connect session options (optional) ---
# Set to true only if your account is registered on the China service (garmin.cn).
# GARMIN__IS_CN=false
# Directory where OAuth tokens are cached between runs to avoid re-login/MFA every time.
# GARMIN__TOKENSTORE_PATH=~/.garminconnect

# --- Data layer paths (optional — defaults live under ./data) ---
# DATA__ROOT_DIR=./data
# DATA__BRONZE_DIR=./data/bronze
# DATA__SILVER_DIR=./data/silver
# DATA__LEDGER_DB_PATH=./data/ledger.duckdb
# DATA__MEMORY_DB_PATH=./data/memory.db

# --- Client-side rate limiting (optional) ---
# RATE_LIMIT__MIN_REQUEST_INTERVAL_SECONDS=1.0
# RATE_LIMIT__RETRY_ATTEMPTS=3
